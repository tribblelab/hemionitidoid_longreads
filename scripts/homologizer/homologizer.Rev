#
# homologizer: joint inference of polyploid phasing + phylogeny
# adapted from wf8/homologizer src/cystopteridaceae.Rev
#
# Run from the project root after prep_homologizer.jl:
#     rb scripts/homologizer/homologizer.Rev
# run_homologizer.sh sets run_id (and seeds) for independent replicate runs.
#

if (!exists("run_id")) { run_id = 1 }
if (!exists("bayes_factors")) { bayes_factors = FALSE }
if (!exists("n_gen")) { n_gen = 50000 }
sample_freq = 10
phase_weight = 2.0       # raise if phase logs mix poorly

seed(run_id)
rev_dir     = "output/homologizer/rev/"
output_file = "output/homologizer/mcmc/run" + run_id

# alignment paths, locus_names, is_nuclear
source(rev_dir + "loci.Rev")
num_loci = alignments.size()

for (i in 1:num_loci) {
    data[i] = readDiscreteCharacterData(alignments[i])
}

# initial phase of polyploid copies (+ BLANKs for missing copies)
source(rev_dir + "init_phase.Rev")

# add missing taxa so every locus has every tip
for (i in 1:num_loci) {
    for (j in 1:num_loci) {
        data[i].addMissingTaxa(data[j].taxa())
    }
}

num_tips = data[1].ntaxa()
n_branches = 2 * num_tips - 3
print("tips: " + num_tips + "  loci: " + num_loci)

# branch lengths
mvi = 0
for (i in 1:n_branches) {
    branch_lengths[i] ~ dnExponential(10)
    moves[++mvi] = mvScale(branch_lengths[i], weight=1.0)
}

# unrooted topology
topology ~ dnUniformTopology(data[1].taxa())
moves[++mvi] = mvNNI(topology, weight=num_tips)
moves[++mvi] = mvSPR(topology, weight=num_tips / 2)

tree := treeAssembly(topology, branch_lengths)

# GTR per locus, relative rate multipliers
for (i in 1:num_loci) {

    er_prior <- v(1,1,1,1,1,1)
    er[i] ~ dnDirichlet(er_prior)
    er[i].setValue(simplex(v(1,1,1,1,1,1)))
    moves[++mvi] = mvSimplexElementScale(er[i], weight=5)

    pi_prior <- v(1,1,1,1)
    pi[i] ~ dnDirichlet(pi_prior)
    pi[i].setValue(simplex(v(1,1,1,1)))
    moves[++mvi] = mvSimplexElementScale(pi[i], weight=5)

    Q[i] := fnGTR(er[i], pi[i])

    if (i == 1) {
        rate_multiplier[i] <- 1.0
    } else {
        rate_multiplier[i] ~ dnExponential(1)
        moves[++mvi] = mvScale(rate_multiplier[i], weight=5)
    }
}

for (i in 1:num_loci) {
    ctmc[i] ~ dnPhyloCTMC(tree=tree, Q=Q[i], branchRates=rate_multiplier[i], type="DNA")
}

# phasing proposals (nuclear loci only; plastid copies stay on tip A)
source(rev_dir + "phase_moves.Rev")

for (i in 1:num_loci) {
    ctmc[i].clamp(data[i])
}

mymodel = model(Q)

# monitors
mni = 0
monitors[++mni] = mnModel(filename=output_file + ".log", printgen=sample_freq)
monitors[++mni] = mnFile(filename=output_file + ".trees", printgen=sample_freq, tree)
monitors[++mni] = mnScreen(printgen=100)
for (i in 1:num_loci) {
    if (is_nuclear[i]) {
        monitors[++mni] = mnHomeologPhase(filename=output_file + "_" + locus_names[i] + "_phase.log", printgen=sample_freq, ctmc[i])
    }
}

if (bayes_factors) {

    # stepping-stone marginal likelihood (for comparing n-tip phasing models)
    pow_p = powerPosterior(mymodel, moves, monitors, output_file + ".out", cats=50, sampleFreq=sample_freq)
    pow_p.burnin(generations=1000, tuningInterval=100)
    pow_p.run(generations=5000)
    ss = steppingStoneSampler(file=output_file + ".out", powerColumnName="power", likelihoodColumnName="likelihood")
    print("marginal likelihood: " + ss.marginal())

} else {

    mymcmc = mcmc(mymodel, monitors, moves)
    mymcmc.run(generations=n_gen, checkpointInterval=1000, checkpointFile=output_file + ".state")

    treetrace = readTreeTrace(output_file + ".trees", treetype="non-clock", burnin=0.25)
    map_tree = mapTree(treetrace, output_file + "_map.tree")
    mcc_tree = mccTree(treetrace, output_file + "_mcc.tree")
}

q()
